# Full optional ML/NLP runtime, locked for Linux x86_64 CPU execution.
FROM python:3.13-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-linux-cpu.lock /app/backend/requirements-linux-cpu.lock
RUN pip install --no-cache-dir --require-hashes -r backend/requirements-linux-cpu.lock
COPY backend /app/backend
COPY scripts /app/scripts
RUN useradd --create-home researcher && mkdir /app/data /app/.pytest_cache && chown researcher /app/data /app/.pytest_cache
USER researcher
EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
